{
  "name": "ocelot-ui",
  "version": "0.1.1",
  "license": "MIT",
  "author": "Rick Bairstow <rick@rxdesign.co.uk> (https://www.rxdesign.co.uk)",
  "description": "Ocelot UI (OUI), a UI framework built with Vue 3 and Tailwind CSS, is designed to be highly performant, optimized, and accessible. It strikes a balance by providing essential features without being overly opinionated, allowing for flexibility in your projects.",
  "homepage": "https://github.com/rickbairstow/Ocelot",
  "keywords": [
    "component library",
    "vue",
    "tailwind"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickbairstow/Ocelot.git"
  },
  "bugs": {
    "url": "https://github.com/rickbairstow/Ocelot/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "tailwind.css"
  ],
  "main": "./dist/ocelot-ui.umd.js",
  "module": "./dist/ocelot-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ocelot-ui.es.js",
      "require": "./dist/ocelot-ui.umd.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build",
    "build:analyse": "vite build --mode analyze",
    "check-types": "vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "npm run eslint && npm run stylelint",
    "lint:fix": "npm run eslint:fix && npm run stylelint:fix",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "stylelint": "stylelint **/*.css **/*.scss",
    "stylelint:fix": "stylelint **/*.css **/*.scss --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "upgrade-storybook": "npx storybook@latest upgrade",
    "test-storybook": "vitest run --project=storybook",
    "test:docs": "node .storybook/test-docs.mjs",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/vue-table": "^9.3.1",
    "photoswipe": "^5.4.4",
    "plyr": "^3.8.5",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/vue-table": {
      "optional": true
    },
    "photoswipe": {
      "optional": true
    },
    "plyr": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tabler/icons": "^3.49.0",
    "@tabler/icons-vue": "^3.49.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@rushstack/eslint-patch": "^1.16.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/vue3-vite": "^10.6.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-table": "^9.3.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-storybook": "^10.6.2",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "globals": "^17.13.0",
    "photoswipe": "^5.4.4",
    "playwright": "^1.64.1",
    "plyr": "^3.8.5",
    "postcss": "^8.5.23",
    "qrcode": "^1.5.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.105.2",
    "storybook": "^10.6.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.40",
    "vue-component-meta": "^3.3.13",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "storybook": "$storybook"
  }
}
